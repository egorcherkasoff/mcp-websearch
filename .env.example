# ---------------------------------------------------------------------------
# MCP web-search stack configuration.
#
# Quick start:  ./scripts/init-env.sh   (creates .env with fresh secrets)
# Manual start: cp .env.example .env    then fill in the secrets below.
# ---------------------------------------------------------------------------

# Address the published ports bind to.
#   0.0.0.0        = every interface (LAN + ZeroTier)
#   <zt-ip>        = ZeroTier interface only, e.g. 192.168.192.10
BIND_ADDR=0.0.0.0

# Host ports (inside containers SearXNG listens on 8080, MCP on 8765).
SEARXNG_PORT=8088
MCP_PORT=8765

# Pin image versions here for reproducible deployments.
SEARXNG_IMAGE_TAG=latest
CRAWL4AI_IMAGE_TAG=latest

# Secret key for SearXNG (any long random string): openssl rand -hex 32
SEARXNG_SECRET=change-me

# Bearer token required by the MCP server: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me

# Bearer token for the Crawl4AI REST API. Also switches Crawl4AI from
# loopback-only to a network-reachable bind: openssl rand -hex 32
CRAWL4AI_API_TOKEN=change-me
